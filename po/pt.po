#. TRANSLATORS: Short status under the toggle's title (keep it short).
#: nordvpn-toggle@ticko4.github.io/extension.js:73
msgid "Not installed"
msgstr "Não instalado"

#: nordvpn-toggle@ticko4.github.io/extension.js:74
msgid "The nordvpn command was not found. Install the NordVPN app."
msgstr "O comando nordvpn não foi encontrado. Instale a aplicação NordVPN."

#. TRANSLATORS: Short status under the toggle's title (keep it short).
#: nordvpn-toggle@ticko4.github.io/extension.js:79
msgid "No permission"
msgstr "Sem permissão"

#. TRANSLATORS: Keep the command between quotes as it is.
#: nordvpn-toggle@ticko4.github.io/extension.js:81
msgid ""
"Your user is not in the nordvpn group. Run “sudo usermod -aG nordvpn $USER”, "
"then log out and back in."
msgstr ""
"O seu utilizador não está no grupo nordvpn. Execute «sudo usermod -aG "
"nordvpn $USER» e depois termine a sessão e volte a entrar."

#. TRANSLATORS: Short status under the toggle's title (keep it short).
#: nordvpn-toggle@ticko4.github.io/extension.js:86
msgid "Service not running"
msgstr "Serviço parado"

#. TRANSLATORS: Keep the command between quotes as it is.
#: nordvpn-toggle@ticko4.github.io/extension.js:88
msgid ""
"The NordVPN service is not running. Start it with “sudo systemctl enable --"
"now nordvpnd”."
msgstr ""
"O serviço do NordVPN não está em execução. Inicie-o com «sudo systemctl "
"enable --now nordvpnd»."

#. TRANSLATORS: Short status under the toggle's title (keep it short).
#: nordvpn-toggle@ticko4.github.io/extension.js:93
#: nordvpn-toggle@ticko4.github.io/extension.js:563
msgid "Not logged in"
msgstr "Sessão não iniciada"

#: nordvpn-toggle@ticko4.github.io/extension.js:94
msgid "Log in with the NordVPN app."
msgstr "Inicie sessão na aplicação NordVPN."

#. TRANSLATORS: Short status under the toggle's title (keep it short).
#: nordvpn-toggle@ticko4.github.io/extension.js:99
msgid "Error"
msgstr "Erro"

#: nordvpn-toggle@ticko4.github.io/extension.js:100
msgid "Unknown error"
msgstr "Erro desconhecido"

#. TRANSLATORS: Connect to the server NordVPN recommends (usually the fastest), anywhere or in the chosen country.
#: nordvpn-toggle@ticko4.github.io/extension.js:179
#: nordvpn-toggle@ticko4.github.io/extension.js:413
#: nordvpn-toggle@ticko4.github.io/extension.js:441
msgid "Recommended server"
msgstr "Servidor recomendado"

#. TRANSLATORS: Heading above the search field and the list of countries and cities.
#: nordvpn-toggle@ticko4.github.io/extension.js:322
msgid "Locations"
msgstr "Localizações"

#: nordvpn-toggle@ticko4.github.io/extension.js:326
msgid "Search…"
msgstr "Procurar…"

#. TRANSLATORS: Opens the NordVPN app (for login, settings, etc.).
#: nordvpn-toggle@ticko4.github.io/extension.js:366
msgid "Open NordVPN"
msgstr "Abrir o NordVPN"

#: nordvpn-toggle@ticko4.github.io/extension.js:420
#: nordvpn-toggle@ticko4.github.io/extension.js:447
msgid "Loading…"
msgstr "A carregar…"

#: nordvpn-toggle@ticko4.github.io/extension.js:426
#: nordvpn-toggle@ticko4.github.io/extension.js:457
msgid "No matches"
msgstr "Sem resultados"

#. TRANSLATORS: Heading above the locations used most recently.
#: nordvpn-toggle@ticko4.github.io/extension.js:472
msgid "Recent"
msgstr "Recentes"

#. TRANSLATORS: Menu header when connected but the location is unknown.
#: nordvpn-toggle@ticko4.github.io/extension.js:549
msgid "Connected"
msgstr "Ligado"

#: nordvpn-toggle@ticko4.github.io/extension.js:552
msgid "Connecting…"
msgstr "A ligar…"

#: nordvpn-toggle@ticko4.github.io/extension.js:555
msgid "Disconnecting…"
msgstr "A desligar…"

#: nordvpn-toggle@ticko4.github.io/extension.js:561
msgid "Disconnected"
msgstr "Desligado"

#: nordvpn-toggle@ticko4.github.io/extension.js:682
msgid "NordVPN is not available"
msgstr "O NordVPN não está disponível"

#: nordvpn-toggle@ticko4.github.io/extension.js:701
msgid "Could not connect to NordVPN"
msgstr "Não foi possível ligar ao NordVPN"

#: nordvpn-toggle@ticko4.github.io/extension.js:711
msgid "Could not disconnect from NordVPN"
msgstr "Não foi possível desligar do NordVPN"
